<Window x:Class="HomeCareManagerApp.EditUserEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit user"
        Height="520"
        Width="520"
        MinHeight="500"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1565C0" />
        <SolidColorBrush x:Key="TextBrush" Color="#1A2340" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6F8D" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E3F2FD" />
            <Setter Property="Foreground" Value="#1565C0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Edit user"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="24"
                       FontWeight="Bold" />
            <TextBlock Text="Update account details without changing the password."
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,6,0,20"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Full name" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="NameTextBox" Height="36" Margin="0,0,0,12" />

            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" />
            <TextBox x:Name="EmailTextBox" Height="36" Margin="0,0,0,12" />

            <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox x:Name="RoleComboBox" Height="36" Margin="0,0,0,12">
                <ComboBoxItem Content="Admin" Tag="admin" />
                <ComboBoxItem Content="Doctor" Tag="doctor" />
                <ComboBoxItem Content="Assistant" Tag="assistant" />
            </ComboBox>

            <TextBlock Text="Skill" Style="{StaticResource FieldLabelStyle}" />
            <ComboBox x:Name="SkillComboBox"
                      Height="36"
                      DisplayMemberPath="Name"
                      ItemsSource="{Binding Skills}"
                      Margin="0,0,0,12" />

            <CheckBox x:Name="IsActiveCheckBox"
                      Content="Active user"
                      Foreground="{StaticResource TextBrush}" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="Cancel_Click" />
            <Button Content="Save changes"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
