<Window x:Class="HomeCareManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HomeCare Manager"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1565C0" />
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#F4F9FF" />
        <SolidColorBrush x:Key="TealBrush" Color="#00897B" />
        <SolidColorBrush x:Key="GoldBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="TextBrush" Color="#1A2340" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6F8D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9E2EF" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DCEBFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2B7DD2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E3F2FD" />
            <Setter Property="Foreground" Value="#1565C0" />
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,12" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="GridActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="17*"/>
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BlueBrush}" Grid.RowSpan="2">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="HomeCare Manager"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Bold" />
                    <TextBlock Text="Care coordination"
                               Foreground="#BFD9F8"
                               FontSize="13"
                               Margin="0,3,0,24" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <Button x:Name="DashboardNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Dashboard"
                            Click="Navigate_Click"
                            Content="Dashboard" />
                    <Button x:Name="PatientsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Patients"
                            Click="Navigate_Click"
                            Content="Patients" />
                    <Button x:Name="TasksNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Tasks"
                            Click="Navigate_Click"
                            Content="Tasks" />
                    <Button x:Name="IncidentsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Incidents"
                            Click="Navigate_Click"
                            Content="Incidents" />
                    <Button x:Name="AdminNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Administration"
                            Click="Navigate_Click"
                            Content="Administration" />
                </StackPanel>

                <Border Grid.Row="2"
                        Cursor="Hand"
                        Background="#1E73C8"
                        CornerRadius="8"
                        Padding="14"
                        MouseLeftButtonUp="OpenProfile_Click">
                    <StackPanel>
                        <TextBlock x:Name="CurrentUserNameText"
                                   Text=""
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentUserEmailText"
                                   Text=""
                                   Foreground="#CFE5FF"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="Dashboard"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="PageSubtitleText"
                                   Text="Operational overview for home care services"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ConnectionStatusText"
                                   Text="Disconnected"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <Button x:Name="NewTaskButton"
                            Content="New task"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="OpenCreateTask_Click" />

                        <Button Content="Sync"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ReloadData_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28">
                    <Grid x:Name="DashboardView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <UniformGrid x:Name="DashboardStatsGrid" Columns="4">
                            <Border x:Name="AssistantsDashboardCard" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="Active patients" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="PatientCountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="PatientMetaText" Text="Loading data" Foreground="{StaticResource TealBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="Pending tasks" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="TaskCountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="TaskMetaText" Text="Pending review" Foreground="{StaticResource GoldBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="Assistants" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="UserCountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="UserMetaText" Text="Active users" Foreground="{StaticResource TealBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="IncidentsDashboardCard" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Incidents" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="IncidentCountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" />
                                    <TextBlock Text="Require follow-up" Foreground="#D97706" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Operational alerts" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                                <ListView Margin="0,14,0,0"
                                          BorderThickness="0"
                                          ItemsSource="{Binding DashboardAlerts}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="{Binding SeverityBackground}"
                                                        CornerRadius="8"
                                                        Padding="10,4"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Type}"
                                                               Foreground="{Binding SeverityForeground}"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Message}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Detail}"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               FontSize="12"
                                                               Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Tasks needing attention" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                                    <ListView Margin="0,14,0,0"
                                              BorderThickness="0"
                                              ItemsSource="{Binding DashboardTasks}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Button CommandParameter="{Binding}"
                                                        Click="OpenTaskDetail_Click"
                                                        HorizontalContentAlignment="Stretch"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand">
                                                    <Grid Margin="0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                            <TextBlock Text="{Binding DueLine}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1"
                                                                Background="{Binding DashboardStatusBackground}"
                                                                CornerRadius="8"
                                                                Padding="10,4"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding DashboardStatusLabel}"
                                                                       Foreground="{Binding DashboardStatusForeground}"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Recent task history" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                                    <ListView Margin="0,14,0,0"
                                              BorderThickness="0"
                                              ItemsSource="{Binding DashboardHistoryTasks}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Button CommandParameter="{Binding}"
                                                        Click="OpenTaskDetail_Click"
                                                        HorizontalContentAlignment="Stretch"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="0"
                                                        Cursor="Hand">
                                                    <StackPanel Margin="0,8">
                                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding HistoryLine}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="PatientsView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Patients"
                                           Style="{StaticResource SectionTitleStyle}"
                                           FontSize="18"
                                           VerticalAlignment="Center" />
                                <Button x:Name="NewPatientButton"
                                    Grid.Column="1"
                                    Content="New patient"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="NewPatient_Click" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PatientSearchTextBox"
                                                 Height="34"
                                                 VerticalContentAlignment="Center"
                                                 Padding="10,0"
                                                 TextChanged="PatientSearch_TextChanged" />
                                        <TextBlock Grid.Column="1"
                                                   Text="Search by name, zone, phone, address, priority, or notes"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="12,0,0,0" />
                                        <TextBlock x:Name="PatientResultCountText"
                                                   Grid.Column="2"
                                                   Text="0 patients"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Margin="0,0,0,0" ItemsSource="{Binding VisiblePatients}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="120" />
                                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100" />
                                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                                            <DataGridTemplateColumn Header="Actions" Width="160">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="Edit"
                        Style="{StaticResource GridActionButtonStyle}"
                        CommandParameter="{Binding}"
                        Click="EditPatient_Click"
                        Visibility="{Binding ElementName=NewPatientButton, Path=Visibility}" />
                                                            <Button Content="Delete"
                        Style="{StaticResource GridActionButtonStyle}"
                        CommandParameter="{Binding}"
                        Click="DeletePatient_Click"
                        Visibility="{Binding ElementName=NewPatientButton, Path=Visibility}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="TasksView" Visibility="Collapsed">
                        <Border Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                MinHeight="520">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Task status"
                                               Style="{StaticResource SectionTitleStyle}"
                                               FontSize="20"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="TaskResultCountText"
                                               Grid.Column="1"
                                               Text="0 tasks"
                                               Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />

                                    <WrapPanel Grid.Row="1"
                                               Grid.ColumnSpan="2"
                                               Margin="0,14,0,0">
                                        <StackPanel Width="220" Margin="0,0,14,0">
                                            <TextBlock Text="Patient" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="TaskPatientFilterComboBox"
                                                      Height="34"
                                                      DisplayMemberPath="Name"
                                                      ItemsSource="{Binding TaskFilterPatientOptions}"
                                                      SelectionChanged="TaskFilter_Changed" />
                                        </StackPanel>
                                        <StackPanel Width="170" Margin="0,0,14,0">
                                            <TextBlock Text="Assignment" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="TaskAssignmentFilterComboBox"
                                                      Height="34"
                                                      SelectedIndex="0"
                                                      SelectionChanged="TaskFilter_Changed">
                                                <ComboBoxItem Content="All" Tag="all" />
                                                <ComboBoxItem Content="Assigned" Tag="assigned" />
                                                <ComboBoxItem Content="Unassigned" Tag="unassigned" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Width="160" Margin="0,0,14,0">
                                            <TextBlock Text="Status" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="TaskStatusFilterComboBox"
                                                      Height="34"
                                                      SelectedIndex="0"
                                                      SelectionChanged="TaskFilter_Changed">
                                                <ComboBoxItem Content="All" Tag="all" />
                                                <ComboBoxItem Content="Pending" Tag="pending" />
                                                <ComboBoxItem Content="Assigned" Tag="assigned" />
                                                <ComboBoxItem Content="Accepted" Tag="accepted" />
                                                <ComboBoxItem Content="In progress" Tag="in-progress" />
                                                <ComboBoxItem Content="Completed" Tag="completed" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Width="150" Margin="0,0,14,0">
                                            <TextBlock Text="Priority" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="TaskPriorityFilterComboBox"
                                                      Height="34"
                                                      SelectedIndex="0"
                                                      SelectionChanged="TaskFilter_Changed">
                                                <ComboBoxItem Content="All" Tag="all" />
                                                <ComboBoxItem Content="High" Tag="High" />
                                                <ComboBoxItem Content="Medium" Tag="Medium" />
                                                <ComboBoxItem Content="Low" Tag="Low" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Width="190">
                                            <TextBlock Text="Sort" Style="{StaticResource FieldLabelStyle}" />
                                            <ComboBox x:Name="TaskSortComboBox"
                                                      Height="34"
                                                      SelectedIndex="0"
                                                      SelectionChanged="TaskFilter_Changed">
                                                <ComboBoxItem Content="Date newest" Tag="date-desc" />
                                                <ComboBoxItem Content="Date oldest" Tag="date-asc" />
                                                <ComboBoxItem Content="Priority high first" Tag="priority-desc" />
                                                <ComboBoxItem Content="Priority low first" Tag="priority-asc" />
                                            </ComboBox>
                                        </StackPanel>
                                    </WrapPanel>
                                </Grid>

                                <DataGrid AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          CanUserSortColumns="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding VisibleTasks}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.4*" />
                                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="1.3*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1*" />
                                        <DataGridTextColumn Header="Assigned to" Binding="{Binding AssignmentDisplay}" Width="1.2*" />
                                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="0.8*" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=d}" Width="0.9*" />
                                        <DataGridTemplateColumn Header="Actions" Width="300">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Edit"
                                                                Style="{StaticResource GridActionButtonStyle}"
                                                                CommandParameter="{Binding}"
                                                                Click="EditTask_Click"
                                                                Visibility="{Binding EditActionVisibility}" />
                                                        <Button Content="{Binding AssignAction}"
                                                                Style="{StaticResource GridActionButtonStyle}"
                                                                CommandParameter="{Binding}"
                                                                Click="AssignTask_Click"
                                                                Visibility="{Binding AssignActionVisibility}" />
                                                        <Button Content="Accept"
                                                                Style="{StaticResource GridActionButtonStyle}"
                                                                CommandParameter="{Binding}"
                                                                Click="AcceptTask_Click"
                                                                Visibility="{Binding AcceptActionVisibility}" />
                                                        <Button Content="Reject"
                                                                Style="{StaticResource GridActionButtonStyle}"
                                                                CommandParameter="{Binding}"
                                                                Click="RejectTask_Click"
                                                                Visibility="{Binding RejectActionVisibility}" />
                                                        <Button Content="Complete"
                                                                Style="{StaticResource GridActionButtonStyle}"
                                                                CommandParameter="{Binding}"
                                                                Click="CompleteTask_Click"
                                                                Visibility="{Binding CompleteActionVisibility}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border x:Name="CreateTaskPanel"
                                Visibility="Collapsed"
                                Background="White"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Width="440"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="TaskEditorTitleText"
                                               Text="Create task"
                                               Style="{StaticResource SectionTitleStyle}"
                                               FontSize="18"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="Cancel"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CancelCreateTask_Click" />
                                </Grid>
                                <TextBlock Text="Patient" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,2" />
                                <ComboBox x:Name="TaskPatientComboBox"
                                          Height="36"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding PatientOptions}" />
                                <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
                                <TextBox x:Name="TaskDescriptionTextBox"
                                         Height="82"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" />
                                        <DatePicker x:Name="TaskDatePicker" Height="36" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Priority" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="TaskPriorityComboBox" Height="36" SelectedIndex="0">
                                            <ComboBoxItem Content="High" />
                                            <ComboBoxItem Content="Medium" />
                                            <ComboBoxItem Content="Low" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Required skill" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
                                <ComboBox x:Name="TaskSkillComboBox"
                                          Height="36"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding SkillOptions}" />
                                <TextBlock x:Name="TaskStatusLabelText"
                                           Text="Initial status"
                                           Style="{StaticResource FieldLabelStyle}"
                                           Margin="0,12,0,2" />
                                <ComboBox x:Name="TaskStatusComboBox"
                                          Height="36"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding StatusOptions}" />
                                <Button x:Name="SaveTaskButton"
                                        Content="Save task"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,18,0,0"
                                        Click="SaveTask_Click" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="IncidentsView" Visibility="Collapsed">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Incident follow-up" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                                        <TextBlock x:Name="IncidentResultCountText"
                                                   Text="0 incidents"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                    <ComboBox x:Name="IncidentStatusFilterComboBox"
                                              Grid.Column="1"
                                              Width="160"
                                              Height="34"
                                              SelectedIndex="0"
                                              SelectionChanged="IncidentFilter_Changed">
                                        <ComboBoxItem Content="Active" Tag="active" />
                                        <ComboBoxItem Content="Open" Tag="open" />
                                        <ComboBoxItem Content="In review" Tag="in-review" />
                                        <ComboBoxItem Content="Resolved" Tag="resolved" />
                                        <ComboBoxItem Content="Closed" Tag="closed" />
                                        <ComboBoxItem Content="All" Tag="all" />
                                    </ComboBox>
                                </Grid>
                                <ListView Margin="0,14,0,0"
                                          BorderThickness="0"
                                          ItemsSource="{Binding VisibleIncidents}">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0,0,0,10" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FAFCFF"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                            <Border Background="{Binding SeverityBackground}"
                                                                    CornerRadius="8"
                                                                    Padding="9,3"
                                                                    Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Severity}"
                                                                           Foreground="{Binding SeverityForeground}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Background="{Binding StatusBackground}"
                                                                    CornerRadius="8"
                                                                    Padding="9,3">
                                                                <TextBlock Text="{Binding StatusLine}"
                                                                           Foreground="{Binding StatusForeground}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>

                                                        <TextBlock Text="{Binding Description}"
                                                                   Foreground="{StaticResource TextBrush}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Patient}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="12"
                                                                   Margin="0,5,0,0" />
                                                        <TextBlock Text="{Binding Task}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding CreatedLine}"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   FontSize="12"
                                                                   Margin="0,8,0,0" />
                                                        <TextBlock Text="{Binding ReportLabel}"
                                                                   Foreground="{StaticResource BlueBrush}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Content="Open"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            CommandParameter="{Binding}"
                                                            Click="OpenIncidentDetail_Click"
                                                            VerticalAlignment="Top"
                                                            Margin="18,0,0,0" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="AdminView" Visibility="Collapsed">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Users"
                                               Style="{StaticResource SectionTitleStyle}"
                                               FontSize="18"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="New user"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CreateUser_Click" />
                                </Grid>

                                <DataGrid AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding Users}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*" />
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.6*" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="130" />
                                        <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="80" />
                                        <DataGridTemplateColumn Header="Actions" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Edit"
                                                                Style="{StaticResource GridActionButtonStyle}"
                                                                CommandParameter="{Binding}"
                                                                Click="EditUser_Click" />
                                                        <Button Content="Delete"
                                                                Style="{StaticResource GridActionButtonStyle}"
                                                                CommandParameter="{Binding}"
                                                                Click="DeleteUser_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
