<Window x:Class="HomeCareManagerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="HomeCare Manager"
        Height="760"
        Width="1180"
        MinHeight="680"
        MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1565C0" />
        <SolidColorBrush x:Key="BlueSoftBrush" Color="#F4F9FF" />
        <SolidColorBrush x:Key="TealBrush" Color="#00897B" />
        <SolidColorBrush x:Key="GoldBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="TextBrush" Color="#1A2340" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6F8D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9E2EF" />

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DCEBFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2B7DD2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E3F2FD" />
            <Setter Property="Foreground" Value="#1565C0" />
        </Style>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,12" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="GridActionButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="17*"/>
            <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BlueBrush}" Grid.RowSpan="2">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="HomeCare Manager"
                               Foreground="White"
                               FontSize="21"
                               FontWeight="Bold" />
                    <TextBlock Text="Care coordination"
                               Foreground="#BFD9F8"
                               FontSize="13"
                               Margin="0,3,0,24" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,18,0,0">
                    <Button x:Name="DashboardNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Dashboard"
                            Click="Navigate_Click"
                            Content="Dashboard" />
                    <Button x:Name="PatientsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Patients"
                            Click="Navigate_Click"
                            Content="Patients" />
                    <Button x:Name="TasksNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Tasks"
                            Click="Navigate_Click"
                            Content="Tasks" />
                    <Button x:Name="IncidentsNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Incidents"
                            Click="Navigate_Click"
                            Content="Incidents" />
                    <Button x:Name="AdminNavButton"
                            Style="{StaticResource NavButtonStyle}"
                            Tag="Administration"
                            Click="Navigate_Click"
                            Content="Administration" />
                </StackPanel>

                <Border Grid.Row="2"
                        Cursor="Hand"
                        Background="#1E73C8"
                        CornerRadius="8"
                        Padding="14"
                        MouseLeftButtonUp="OpenProfile_Click">
                    <StackPanel>
                        <TextBlock x:Name="CurrentUserNameText"
                                   Text=""
                                   Foreground="White"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="CurrentUserEmailText"
                                   Text=""
                                   Foreground="#CFE5FF"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitleText"
                                   Text="Dashboard"
                                   Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock x:Name="PageSubtitleText"
                                   Text="Operational overview for home care services"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="13"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ConnectionStatusText"
                                   Text="Disconnected"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <Button x:Name="NewTaskButton"
                            Content="New task"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Margin="0,0,10,0"
                            Click="OpenCreateTask_Click" />

                        <Button Content="Sync"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ReloadData_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="28">
                    <Grid x:Name="DashboardView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="22" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <UniformGrid Columns="4">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="Active patients" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="PatientCountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="PatientMetaText" Text="Loading data" Foreground="{StaticResource TealBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="Pending tasks" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="TaskCountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="TaskMetaText" Text="Pending review" Foreground="{StaticResource GoldBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,14,0">
                                <StackPanel>
                                    <TextBlock Text="Assistants" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="UserCountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" />
                                    <TextBlock x:Name="UserMetaText" Text="Active users" Foreground="{StaticResource TealBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Incidents" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock x:Name="IncidentCountText" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0" />
                                    <TextBlock Text="Require follow-up" Foreground="#D97706" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Today's tasks" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                                <ListView Margin="0,14,0,0"
                                          BorderThickness="0"
                                          ItemsSource="{Binding Tasks}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="8" Padding="10,4">
                                                    <TextBlock Text="{Binding Priority}" Foreground="{StaticResource BlueBrush}" FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="PatientsView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="18" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Patients"
                                           Style="{StaticResource SectionTitleStyle}"
                                           FontSize="18"
                                           VerticalAlignment="Center" />
                                <Button x:Name="NewPatientButton"
                                    Grid.Column="1"
                                    Content="New patient"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="NewPatient_Click" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                                <StackPanel>
                                    <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Margin="0,14,0,0" ItemsSource="{Binding Patients}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                                            <DataGridTextColumn Header="Zone" Binding="{Binding Zone}" Width="120" />
                                            <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="100" />
                                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <Grid x:Name="TasksView" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CreateTaskPanel"
                            Background="White"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel>
                                <TextBlock Text="Create task" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                                <TextBlock Text="Patient" Style="{StaticResource FieldLabelStyle}" Margin="0,18,0,2" />
                                <ComboBox x:Name="TaskPatientComboBox"
                                          Height="36"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding PatientOptions}" />
                                <TextBlock Text="Description" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
                                <TextBox x:Name="TaskDescriptionTextBox"
                                         Height="82"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" />
                                        <DatePicker x:Name="TaskDatePicker" Height="36" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Priority" Style="{StaticResource FieldLabelStyle}" />
                                        <ComboBox x:Name="TaskPriorityComboBox" Height="36" SelectedIndex="0">
                                            <ComboBoxItem Content="High" />
                                            <ComboBoxItem Content="Medium" />
                                            <ComboBoxItem Content="Low" />
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Required skill" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
                                <ComboBox x:Name="TaskSkillComboBox"
                                          Height="36"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding SkillOptions}" />
                                <TextBlock Text="Initial status" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,2" />
                                <ComboBox x:Name="TaskStatusComboBox"
                                          Height="36"
                                          DisplayMemberPath="Name"
                                          ItemsSource="{Binding StatusOptions}" />
                                <Button Content="Save task" Style="{StaticResource PrimaryButtonStyle}" Margin="0,18,0,0" Click="SaveTask_Click" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Task status" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                                <ListBox Margin="0,14,0,0"
                                         BorderThickness="0"
                                         ItemsSource="{Binding Tasks}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,8">
                                                <TextBlock Text="{Binding StatusLine}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding PatientName}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="IncidentsView" Visibility="Collapsed">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel>
                                <TextBlock Text="Open incidents" Style="{StaticResource SectionTitleStyle}" FontSize="18" />
                                <DataGrid AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False" Margin="0,14,0,0" ItemsSource="{Binding Incidents}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Patient" Binding="{Binding Patient}" Width="*" />
                                        <DataGridTextColumn Header="Task" Binding="{Binding Task}" Width="*" />
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="AdminView" Visibility="Collapsed">
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <DockPanel LastChildFill="True">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="Users"
                                               Style="{StaticResource SectionTitleStyle}"
                                               FontSize="18"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Content="New user"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Click="CreateUser_Click" />
                                </Grid>

                                <DataGrid AutoGenerateColumns="False"
                                          HeadersVisibility="Column"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          ItemsSource="{Binding Users}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.2*" />
                                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.6*" />
                                        <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="130" />
                                        <DataGridTextColumn Header="Active" Binding="{Binding Active}" Width="80" />
                                        <DataGridTemplateColumn Header="Actions" Width="170">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <Button Content="Edit"
                                                                Style="{StaticResource GridActionButtonStyle}"
                                                                CommandParameter="{Binding}"
                                                                Click="EditUser_Click" />
                                                        <Button Content="Delete"
                                                                Style="{StaticResource GridActionButtonStyle}"
                                                                CommandParameter="{Binding}"
                                                                Click="DeleteUser_Click" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
