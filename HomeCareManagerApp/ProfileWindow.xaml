<Window x:Class="HomeCareManagerApp.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile"
        Height="760"
        Width="680"
        MinHeight="700"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="BlueBrush" Color="#1565C0" />
        <SolidColorBrush x:Key="TextBrush" Color="#1A2340" />
        <SolidColorBrush x:Key="MutedBrush" Color="#5F6F8D" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9E2EF" />

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BlueBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E3F2FD" />
            <Setter Property="Foreground" Value="#1565C0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Profile"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="24"
                       FontWeight="Bold" />
            <TextBlock Text="Account details"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,6,0,20" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel>
                    <Button Content="Log out"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,16"
                            Click="Logout_Click" />

                    <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="NameTextBlock"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="EmailTextBlock"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Role" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="RoleTextBlock"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Skill" Style="{StaticResource FieldLabelStyle}" />
                    <TextBlock x:Name="SkillTextBlock"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="14"
                               Margin="0,0,0,18" />

                    <TextBlock Text="Availability"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,12" />

                    <ListView ItemsSource="{Binding AvailabilitySlots}"
                              MaxHeight="180"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              Margin="0,0,0,14">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Date" DisplayMemberBinding="{Binding DateDisplay}" Width="110" />
                                <GridViewColumn Header="Start" DisplayMemberBinding="{Binding StartDisplay}" Width="80" />
                                <GridViewColumn Header="End" DisplayMemberBinding="{Binding EndDisplay}" Width="80" />
                                <GridViewColumn Header="Zone" DisplayMemberBinding="{Binding Zone}" Width="180" />
                                <GridViewColumn Header="Actions" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="Delete"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Padding="8,4"
                                                    CommandParameter="{Binding}"
                                                    Click="DeleteAvailability_Click" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.8*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Date" Style="{StaticResource FieldLabelStyle}" />
                        <DatePicker x:Name="AvailabilityDatePicker"
                                    Grid.Row="1"
                                    Height="36" />

                        <TextBlock Grid.Column="2" Text="Start" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="StartTimeTextBox"
                                 Grid.Row="1"
                                 Grid.Column="2"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Text="09:00" />

                        <TextBlock Grid.Column="4" Text="End" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="EndTimeTextBox"
                                 Grid.Row="1"
                                 Grid.Column="4"
                                 Height="36"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0"
                                 Text="17:00" />

                        <TextBlock Grid.Row="2" Text="Zone" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,4" />
                        <TextBox x:Name="AvailabilityZoneTextBox"
                                 Grid.Row="3"
                                 Grid.ColumnSpan="3"
                                 Height="36"
                                 Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"
                                 Padding="8,0" />
                        <Button Grid.Row="3"
                                Grid.Column="4"
                                Content="Add slot"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0"
                                Click="AddAvailability_Click" />
                    </Grid>

                    <Border x:Name="PasswordWarningBorder"
                            Background="#FFF8E1"
                            BorderBrush="#F3D58B"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,18"
                            Visibility="Collapsed">
                        <TextBlock Text="You must change your initial password."
                                   Foreground="#6B5A2B"
                                   TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Text="Change password"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,14" />

                    <TextBlock Text="Current password" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="CurrentPasswordBox" Height="36" Margin="0,0,0,12" />

                    <TextBlock Text="New password" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="NewPasswordBox" Height="36" Margin="0,0,0,12" />

                    <TextBlock Text="Confirm new password" Style="{StaticResource FieldLabelStyle}" />
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="36" Margin="0,0,0,12" />

                    <Button Content="Change password"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HorizontalAlignment="Left"
                            Click="ChangePassword_Click" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Close"
                Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                Click="Close_Click" />
    </Grid>
</Window>
