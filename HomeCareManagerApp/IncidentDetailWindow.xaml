<Window x:Class="HomeCareManagerApp.IncidentDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Incident details"
        Height="650"
        Width="720"
        MinHeight="580"
        MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Incident details"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1A2340" />
            <TextBlock x:Name="SubtitleText"
                       Margin="0,5,0,18"
                       Foreground="#5F6F8D"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White"
                        BorderBrush="#D9E2EF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Follow-up"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#1A2340" />
                            <TextBlock x:Name="SeverityText"
                                       Grid.Column="1"
                                       FontWeight="SemiBold"
                                       Foreground="#B91C1C" />
                        </Grid>

                        <TextBlock Text="Incident" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="DescriptionText"
                                   Foreground="#1A2340"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,12" />

                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Patient" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="PatientText" Foreground="#1A2340" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Created" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="CreatedText" Foreground="#1A2340" Margin="0,3,0,0" />
                            </StackPanel>
                        </UniformGrid>

                        <TextBlock Text="Related task" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="TaskText"
                                   Foreground="#1A2340"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,14" />

                        <TextBlock Text="Status" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                        <ComboBox x:Name="StatusComboBox" Height="34" Margin="0,4,0,12">
                            <ComboBoxItem Content="Open" />
                            <ComboBoxItem Content="In review" />
                            <ComboBoxItem Content="Resolved" />
                            <ComboBoxItem Content="Closed" />
                        </ComboBox>

                        <TextBlock Text="Resolution notes" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                        <TextBox x:Name="ResolutionNotesTextBox"
                                 Height="90"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#D9E2EF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Care report"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1A2340"
                                   Margin="0,0,0,12" />
                        <TextBlock x:Name="ReportEmptyText"
                                   Text="No report is linked to this incident yet."
                                   Foreground="#5F6F8D"
                                   Visibility="Collapsed" />
                        <StackPanel x:Name="ReportPanel">
                            <UniformGrid Columns="2" Margin="0,0,0,12">
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Report id" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReportIdText" Foreground="#1A2340" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Created by" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReportCreatedByText" Foreground="#1A2340" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,12,12">
                                    <TextBlock Text="Created" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReportCreatedText" Foreground="#1A2340" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock Text="Duration" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock x:Name="ReportDurationText" Foreground="#1A2340" Margin="0,3,0,0" />
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Status change" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReportStatusText" Foreground="#1A2340" Margin="0,3,0,12" />
                            <TextBlock Text="Notes" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="ReportNotesText"
                                       Foreground="#1A2340"
                                       TextWrapping="Wrap"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel"
                    Width="96"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="Save"
                    Width="96"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
