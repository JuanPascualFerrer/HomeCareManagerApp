<Window x:Class="HomeCareManagerApp.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task details"
        Height="560"
        Width="620"
        MinHeight="520"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Task details"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#1A2340" />
            <TextBlock x:Name="TaskSubtitleText"
                       Margin="0,5,0,18"
                       Foreground="#5F6F8D"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White"
                        BorderBrush="#D9E2EF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Task"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1A2340"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="Description" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="DescriptionText" Foreground="#1A2340" TextWrapping="Wrap" Margin="0,3,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Status" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusText" Foreground="#1A2340" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Priority" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="PriorityText" Foreground="#1A2340" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Date" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="DateText" Foreground="#1A2340" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Assigned to" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="AssignedToText" Foreground="#1A2340" Margin="0,3,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        BorderBrush="#D9E2EF"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Patient"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1A2340"
                                   Margin="0,0,0,12" />
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Name" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="PatientNameText" Foreground="#1A2340" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Zone" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="PatientZoneText" Foreground="#1A2340" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="Phone" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="PatientPhoneText" Foreground="#1A2340" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Patient priority" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="PatientPriorityText" Foreground="#1A2340" Margin="0,3,0,0" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Address" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="PatientAddressText" Foreground="#1A2340" TextWrapping="Wrap" Margin="0,3,0,12" />
                        <TextBlock Text="Notes" Foreground="#5F6F8D" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="PatientNotesText" Foreground="#1A2340" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Close"
                Width="96"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                Click="Close_Click" />
    </Grid>
</Window>
