<Window x:Class="HomeCareManagerApp.AssignTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HomeCareManagerApp"
        mc:Ignorable="d"
        Title="Assign task" Height="220" Width="520" WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TaskInfoText" FontWeight="SemiBold" FontSize="14" Foreground="#1A2340" />

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Assign to" Foreground="#5F6F8D" FontSize="12" />
            <ComboBox x:Name="WorkerComboBox" Height="32" DisplayMemberPath="DisplayName" SelectedValuePath="UserId" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Width="96" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Assign" Width="96" Click="Assign_Click" />
        </StackPanel>
    </Grid>
</Window>
