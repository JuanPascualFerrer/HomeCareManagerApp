<Window x:Class="HomeCareManagerApp.CompleteTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Complete task"
        Height="540"
        Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#F5F7FA"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Complete task"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="#1A2340" />
            <TextBlock x:Name="TaskInfoText"
                       Margin="0,6,0,18"
                       TextWrapping="Wrap"
                       Foreground="#5F6F8D" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Completion notes"
                       Foreground="#5F6F8D"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBox x:Name="NotesTextBox"
                     Height="130"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />

            <TextBlock Text="Duration"
                       Foreground="#5F6F8D"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Margin="0,14,0,4" />
            <TextBox x:Name="DurationTextBox"
                     Height="34"
                     Text="Not recorded" />

            <CheckBox x:Name="ReportIncidentCheckBox"
                      Content="Report incident"
                      Margin="0,16,0,8"
                      Checked="ReportIncident_Changed"
                      Unchecked="ReportIncident_Changed" />

            <StackPanel x:Name="IncidentPanel" Visibility="Collapsed">
                <TextBlock Text="Incident severity"
                           Foreground="#5F6F8D"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                <ComboBox x:Name="IncidentSeverityComboBox" Height="34" SelectedIndex="1">
                    <ComboBoxItem Content="Low" />
                    <ComboBoxItem Content="Medium" />
                    <ComboBoxItem Content="High" />
                    <ComboBoxItem Content="Critical" />
                </ComboBox>

                <TextBlock Text="Incident description"
                           Foreground="#5F6F8D"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,12,0,4" />
                <TextBox x:Name="IncidentDescriptionTextBox"
                         Height="78"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="Cancel"
                    Width="96"
                    Margin="0,0,8,0"
                    Click="Cancel_Click" />
            <Button Content="Complete"
                    Width="104"
                    Click="Complete_Click" />
        </StackPanel>
    </Grid>
</Window>
